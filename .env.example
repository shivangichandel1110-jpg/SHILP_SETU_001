# ==============================================================================
# SHILP SETU - Environment Configuration Template
# Smart India Hackathon 2026: AI-Powered Marketplace for Local Artisans
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' for local development:
# cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# - NEVER put real secrets in this example file.
# - NEVER prefix GEMINI_API_KEY or SUPABASE_SERVICE_ROLE_KEY with VITE_.
# - Only VITE_ variables are accessible in the browser.
# ==============================================================================

# 1. Supabase Client Credentials (Public / Browser Safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. Supabase Privileged Key (SERVER-SIDE ONLY - Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# 3. Google Gemini API Key (SERVER-SIDE ONLY - Never expose to client)
GEMINI_API_KEY=

# 4. Configurable Gemini Multimodal / Text Model for Product Understanding
GEMINI_TEXT_MODEL=gemini-3.5-flash

# 5. Demo Artisan ID (matches seed.sql demo artisan)
DEMO_ARTISAN_ID=00000000-0000-0000-0000-000000000001
